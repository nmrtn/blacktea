{
  "name": "@nmrtn/blacktea",
  "version": "0.1.7",
  "description": "Spending controls for AI agents paying online.",
  "license": "MIT",
  "author": "Nicolas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blacktea": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "site:theme": "cp brand/theme.css site/theme.css && cp brand/assets/logo/blacktea-mark.svg site/mark.svg",
    "site:engine": "esbuild site/playground/engine.ts --bundle --format=esm --minify --target=es2020 --outfile=site/playground/engine.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "lru-cache": "^11.0.0",
    "x402-fetch": "1.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": ["ai-agents", "payments", "x402", "policy", "audit"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmrtn/blacktea.git"
  },
  "bugs": {
    "url": "https://github.com/nmrtn/blacktea/issues"
  },
  "homepage": "https://github.com/nmrtn/blacktea#readme"
}
